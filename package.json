{
  "name": "hiww",
  "version": "0.1.0",
  "description": "Peer-to-peer cross-border shopping marketplace backend",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "tsx src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx reset-db.ts",
    "db:migrate": "tsx migrations/run.ts",
    "db:setup": "tsx reset-db.ts && tsx migrations/run.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "aws4fetch": "^1.0.20",
    "date-fns": "^2.30.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "kysely": "^0.26.3",
    "pg": "^8.11.3",
    "tsx": "^4.7.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
