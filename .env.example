# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hiww
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000

# Graphile Worker
WORKER_CONCURRENCY=4

# JWT/Auth  (REQUIRED — the app refuses to start without a strong value)
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Money handling
# true  = manual-money pilot: payments/payouts are settled out-of-band and only
#         recorded here by an admin. No funds move automatically.
# false = automated path (NOT implemented yet).
MANUAL_MONEY_PILOT=true

# Providers
PAYMENT_PROVIDER=mock
IDENTITY_PROVIDER=mock

# Payment Processing (placeholder)
PAYMENT_API_URL=https://api.payment-provider.com
PAYMENT_API_KEY=
OPN_API_URL=
OPN_API_KEY=

# Identity Verification (placeholder)
NDID_API_URL=
NDID_API_KEY=

# Mail Service (placeholder)
MAIL_SERVICE_URL=
MAIL_API_KEY=

# Abuse protection (per client IP per window). RATE_LIMIT_* is the global
# ceiling; the money routes and uploads get their own tighter limits.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=20
MONEY_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=20

# Uploads (user-supplied want photos, trip covers, avatars, purchase receipts)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# `local` (default) writes to UPLOAD_DIR on disk. Set `r2` + the five R2_*
# values to store in a Cloudflare R2 bucket instead (needed in production —
# Render's free disk is wiped on every deploy). Anything missing falls back
# to local.
UPLOADS_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public origin (r2.dev dev URL or a custom domain), no trailing slash
R2_PUBLIC_BASE_URL=
# Leave empty to derive file URLs from each request. Set once there is a stable
# public hostname (especially behind a reverse proxy), e.g. https://api.hiww.app
PUBLIC_BASE_URL=

# AI receipt check. `mock` (default) is a deterministic stand-in — no key needed.
# Set to `claude` in production and provide ANTHROPIC_API_KEY to run the real
# check. Advisory only: it flags suspicious receipts to the operator, never
# blocks an order.
AI_RECEIPT_ANALYZER=mock
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Push notifications. `mock` (default) just logs instead of sending — no key
# needed. Set to `fcm` in production and provide FIREBASE_SERVICE_ACCOUNT_JSON
# (the full JSON key downloaded for a Firebase service account, as one env
# var) to send real pushes via Firebase Cloud Messaging. See
# mobile/lib/firebase_options.dart for the matching client-side setup.
PUSH_PROVIDER=mock
FIREBASE_SERVICE_ACCOUNT_JSON=

# Social sign-in. Each provider is independently optional — unset means the
# app returns a clear "not configured" error for that one rather than
# crashing, so they can go live one at a time.
# Google: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web application type).
GOOGLE_CLIENT_ID=
# LINE: LINE Developers Console → your channel → Basic settings (Channel ID)
# and LINE Login (Callback URL — must match this server's public origin +
# /line-callback, e.g. https://hiww.pages.dev/line-callback).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Logging
LOG_LEVEL=debug
