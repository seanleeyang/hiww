# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hiww
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000

# Graphile Worker
WORKER_CONCURRENCY=4

# JWT/Auth  (REQUIRED — the app refuses to start without a strong value)
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Money handling
# true  = manual-money pilot: payments/payouts are settled out-of-band and only
#         recorded here by an admin. No funds move automatically.
# false = automated path (NOT implemented yet).
MANUAL_MONEY_PILOT=true

# Providers
PAYMENT_PROVIDER=mock
IDENTITY_PROVIDER=mock

# Payment Processing (placeholder)
PAYMENT_API_URL=https://api.payment-provider.com
PAYMENT_API_KEY=
OPN_API_URL=
OPN_API_KEY=

# Identity Verification (placeholder)
NDID_API_URL=
NDID_API_KEY=

# Mail Service (placeholder)
MAIL_SERVICE_URL=
MAIL_API_KEY=

# Abuse protection (per client IP per window). RATE_LIMIT_* is the global
# ceiling; the money routes and uploads get their own tighter limits.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=20
MONEY_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=20

# Uploads (user-supplied want photos, trip covers, avatars)
# Local disk during the pilot; move to object storage before production.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Leave empty to derive file URLs from each request. Set once there is a stable
# public hostname (especially behind a reverse proxy), e.g. https://api.hiww.app
PUBLIC_BASE_URL=

# AI receipt check. `mock` (default) is a deterministic stand-in — no key needed.
# Set to `claude` in production and provide ANTHROPIC_API_KEY to run the real
# check. Advisory only: it flags suspicious receipts to the operator, never
# blocks an order.
AI_RECEIPT_ANALYZER=mock
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=debug
